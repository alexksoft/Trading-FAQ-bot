# =====================================================================
# WhatsApp FAQ Bot - Environment Variables
# Copy this file to .env and fill in your values
# =====================================================================

# --- Provider: meta | twilio | dialog360 ---
PROVIDER=meta

# --- Meta Cloud API ---
META_PHONE_NUMBER_ID=your_phone_number_id
META_ACCESS_TOKEN=your_permanent_access_token
META_VERIFY_TOKEN=your_webhook_verify_token
META_APP_SECRET=your_app_secret_for_signature_validation

# --- Twilio (if PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=whatsapp:+14155238886

# --- 360dialog (if PROVIDER=dialog360) ---
DIALOG360_API_KEY=your_360dialog_api_key
DIALOG360_URL=https://waba.360dialog.io/v1/messages

# --- Mentor / Escalation ---
# WhatsApp number to notify when a user requests a mentor (e.g. +1234567890)
MENTOR_NUMBER=+1234567890
# OR a webhook URL to POST mentor notifications to
MENTOR_WEBHOOK=

# How many hours mentor mode stays active before auto-expiry
MENTOR_MODE_TTL_HOURS=24

# --- AI Mentor via Kiro Gateway ---
# Set to true to enable AI coaching in mentor mode
MENTOR_AI_ENABLED=false
KIRO_GATEWAY_URL=http://localhost:9000
KIRO_GATEWAY_API_KEY=your_kiro_gateway_api_key
# Path to the mentor system prompt file
MENTOR_SYSTEM_PROMPT_PATH=config/mentor_prompt.txt

# --- FAQ Config ---
FAQ_CONFIG_PATH=config/faqs.yaml

# --- Logging ---
LOG_LEVEL=INFO

# --- Admin Panel ---
ADMIN_ENABLED=false
ADMIN_TOKEN=change_this_to_a_secret_token

# --- Oracle Cloud / Server ---
# Host and port for uvicorn
HOST=0.0.0.0
PORT=8000
